/**
 * A numbered figure: content full-bleed between rules, then "Figure N", a bold title and the caption.
 * <Figure n={1} title="One step.">...svg or 3D stage...<Fragment slot="caption">What it shows.</Fragment></Figure>
 */
interface Props {
	n?: number | string;
	title?: string;
	id?: string;
}
const { n, title, id } = Astro.props;
---

<figure class="steel-figure not-content" id={id}>
	<div class="frame"><slot /></div>
	<figcaption>
		{n !== undefined && <span class="n">Figure {n}</span>}
		{title && <b>{title}</b>}{' '}
		<slot name="caption" />
	</figcaption>
</figure>
