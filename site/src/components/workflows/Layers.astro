/** The three layers of agents/: workflows put steps in order, steps call tools, tools hold the logic. */
import { loadWorkflows } from '../../lib/workflows-data.mjs';

const { workflows, steps } = loadWorkflows();
const layers = [
	{ name: 'Workflows', count: `${workflows.length}`, where: 'agents/workflows/', what: 'A goal: when to use it, inputs, steps in order, decision points, exit criteria, deliverables.' },
	{ name: 'Steps', count: `${steps.length}`, where: 'agents/steps/', what: 'One procedure: inputs, exact commands, pass and fail criteria, outputs. Calls tools, never a workflow.' },
	{ name: 'Tools', count: 'code', where: 'examples/', what: 'shelf list, play, bench, tune, check, trial, autotune, advise; the render audit. All the logic lives here.' },
];
---

<ol class="layers not-content" aria-label="Layers, from goals to code">
	{
		layers.map((l, i) => (
			<li class:list={{ hot: i === 0 }}>
				<p class="name">
					{l.name} <span class="count">{l.count}</span>
				</p>
				<p class="where"><code>{l.where}</code></p>
				<p class="what">{l.what}</p>
			</li>
		))
	}
</ol>

<style>
	.layers {
		list-style: none;
		padding: 0;
		margin: 1.25rem 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 12px;
		counter-reset: none;
	}
	.layers li {
		margin: 0;
		padding: 12px 14px;
		border: 1px solid var(--rule);
		border-radius: 4px;
		background: var(--panel);
		position: relative;
	}
	.layers li.hot { border-top: 3px solid var(--hot-fill); }
	.layers li + li::before {
		content: '→';
		position: absolute;
		left: -12px;
		top: 50%;
		transform: translate(-50%, -50%);
		color: var(--muted);
		font: 500 14px var(--mono);
	}
	.layers p { margin: 0; }
	.name { font-weight: 600; }
	.count { font: 500 12px var(--mono); color: var(--muted); margin-left: 4px; }
	.where { margin-top: 4px !important; font-size: 13px; overflow-wrap: anywhere; }
	.what { margin-top: 6px !important; font-size: 14px; color: var(--muted); }
	@media (max-width: 50rem) {
		.layers { grid-template-columns: 1fr; }
		.layers li + li::before { content: '↓'; left: 50%; top: -6px; }
	}
</style>
