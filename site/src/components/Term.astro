/**
 * A term with a concept bubble (a short definition and a small diagram), opened by tap, click or keyboard.
 * <Term name="warp">warp</Term>. The definitions live in src/viz/terms.js; add a new term there.
 */
interface Props {
	name: string;
}
const { name } = Astro.props;
---

<button type="button" class="term" data-viz="term" data-term={name}><slot /></button>

<script>
	import '../viz/runtime';
</script>
