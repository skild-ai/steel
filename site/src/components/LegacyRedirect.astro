/** Sends links into the earlier single-page docs (#capacity, #faq-warmstart, ...) to the matching page. */
---

<script>
	import { legacyAnchors } from '../lib/legacy-anchors';

	const target = legacyAnchors[location.hash.slice(1)];
	if (target) location.replace(new URL(target.replace(/^\//, ''), document.baseURI).href);
</script>
