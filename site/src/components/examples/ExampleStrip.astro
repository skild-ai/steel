/** A row of featured examples as poster cards, with a link to the whole gallery. */
import ExampleCard from './ExampleCard.astro';
import { loadExamples } from '../../lib/examples-data.mjs';

interface Props {
	names: string[];
}
const { examples } = loadExamples();
const picks = Astro.props.names.map((name) => {
	const example = examples.find((e) => e.name === name);
	if (!example) throw new Error(`ExampleStrip: no example named ${name}`);
	return example;
});
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="example-strip not-content">
	<ul>
		{picks.map((e) => <ExampleCard example={e} compact />)}
	</ul>
	<p><a href={`${base}/examples/`}>See all {examples.length} examples →</a></p>
</div>

<style>
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 12px;
	}
	@media (max-width: 1000px) {
		ul { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}
	@media (max-width: 520px) {
		ul { grid-template-columns: minmax(0, 1fr); }
	}
	p { margin: 12px 0 0; font-weight: 500; }
</style>
