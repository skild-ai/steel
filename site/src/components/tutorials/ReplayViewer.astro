---
// SPDX-FileCopyrightText: Copyright (c) 2026 Skild AI
// SPDX-License-Identifier: Apache-2.0
/** The 3D replay of one tutorial recording: stage, playback bar and metric charts (src/lib/replay/viewer.ts). */
interface Props {
	src: string;
	meta: object;
	title: string;
}
const { src, meta, title } = Astro.props;
---

<div class="replay not-content" data-src={src} data-meta={JSON.stringify(meta)}>
	<div class="stage" role="img" aria-label={`3D replay of the recorded tutorial: ${title}. Drag to orbit, scroll or pinch to zoom.`}>
		<div class="labels"></div>
		<div class="status" aria-live="polite"></div>
		<div class="readout" hidden></div>
		<div class="hint">drag to orbit · scroll to zoom</div>
	</div>
	<div class="bar">
		<button type="button" class="btn play">Pause</button>
		<input type="range" class="scrub" min="0" max="1000" value="0" aria-label="Time" />
		<span class="time">0.00 s</span>
		<div class="speed" role="group" aria-label="Playback speed">
			<button type="button" class="btn" data-s="0.1">0.1×</button><button type="button" class="btn" data-s="0.25">¼×</button><button
				type="button"
				class="btn"
				data-s="0.5">½×</button
			><button type="button" class="btn on" data-s="1">1×</button><button type="button" class="btn" data-s="2">2×</button>
		</div>
		<button type="button" class="btn recenter">Reset view</button>
	</div>
	<div class="chartwrap"></div>
</div>

<style is:global>
	.replay .stage {
		position: relative;
		background: var(--stage);
		border: 1px solid var(--rule);
		border-radius: 4px;
		overflow: hidden;
		aspect-ratio: 16 / 8.2;
		min-height: 260px;
		max-width: 100%;
	}
	.replay .stage canvas { display: block; width: 100%; height: 100%; }
	.replay .labels { position: absolute; inset: 0; pointer-events: none; }
	.replay .vlabel {
		position: absolute;
		transform: translate(-50%, 0);
		font: 500 12px/1.3 var(--mono);
		padding: 3px 7px;
		border-radius: 3px;
		background: var(--bg);
		border: 1px solid var(--rule);
		white-space: nowrap;
		max-width: 46%;
		overflow: hidden;
		text-overflow: ellipsis;
		color: var(--fg);
	}
	.replay .vlabel i { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; }
	.replay .status { position: absolute; left: 12px; top: 10px; right: 12px; font: 500 12px var(--mono); color: var(--muted); }
	.replay .hint { position: absolute; right: 12px; top: 10px; font: 400 12px var(--mono); color: var(--muted); }
	.replay .readout { position: absolute; left: 12px; top: 34px; display: grid; gap: 6px; pointer-events: none; }
	.replay .readout div {
		font: 500 15px/1.3 var(--mono);
		background: var(--bg);
		border: 1px solid var(--rule);
		border-radius: 4px;
		padding: 6px 10px;
		font-variant-numeric: tabular-nums;
		color: var(--fg);
	}
	.replay .readout b { font-weight: 500; color: var(--hot); }
	.replay .readout span { color: var(--muted); font-size: 12px; display: block; }
	.replay .nogl { padding: 24px; color: var(--muted); }
	@media (max-width: 600px) {
		.replay .readout div { font-size: 12.5px; }
		.replay .hint { display: none; }
		.replay .vlabel { font-size: 11px; }
	}
	.replay .bar { display: flex; align-items: center; gap: 10px 12px; flex-wrap: wrap; margin-top: 10px; }
	.replay .btn {
		font: 500 13px var(--mono);
		background: var(--bg);
		color: var(--muted);
		border: 1px solid var(--rule);
		border-radius: 4px;
		padding: 7px 12px;
		min-height: 36px;
		cursor: pointer;
	}
	.replay .btn:hover { color: var(--fg); border-color: var(--hot-fill); }
	.replay .play { min-width: 84px; }
	.replay .scrub { flex: 1; min-width: 140px; accent-color: var(--hot-fill); min-height: 32px; }
	.replay .time { font: 500 13px var(--mono); font-variant-numeric: tabular-nums; min-width: 118px; color: var(--muted); }
	.replay .speed { display: flex; gap: 4px; }
	.replay .speed .btn { padding: 7px 9px; }
	.replay .speed .btn.on { border-color: var(--hot-fill); color: var(--hot); }
	.replay .chartwrap { margin-top: 20px; }
	.replay .chartblock { border-top: 1px solid var(--rule); padding-top: 14px; margin-top: 6px; }
	.replay .chartblock + .chartblock { margin-top: 22px; }
	.replay .charth {
		display: flex;
		justify-content: space-between;
		gap: 12px;
		flex-wrap: wrap;
		font: 500 12px var(--mono);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.replay .charts { display: grid; gap: 14px; margin-top: 8px; }
	.replay .charts.multi { grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
	.replay .charts svg { width: 100%; height: auto; display: block; overflow: visible; }
	.replay .charts .ct { font: 500 12px var(--mono); color: var(--muted); margin-bottom: 2px; }
	.replay .legend { grid-column: 1 / -1; }
	.tutorial-page .tbl { overflow-x: auto; margin-top: 12px; }
	.tutorial-page .tbl table { border-collapse: collapse; width: 100%; min-width: 440px; font-size: 14px; display: table; }
	.tutorial-page .tbl :is(th, td) { text-align: left; padding: 7px 14px 7px 0; border-bottom: 1px solid var(--rule); vertical-align: top; }
	.tutorial-page .tbl th { font: 500 11px/1.4 var(--mono); letter-spacing: 0.07em; text-transform: uppercase; color: var(--muted); }
	.tutorial-page .tbl td.num { font-family: var(--mono); font-size: 13px; font-variant-numeric: tabular-nums; }
	.tutorial-page .tbl td i { display: inline-block; width: 9px; height: 9px; border-radius: 50%; margin-right: 8px; }
</style>

<script>
	import { mountReplay } from '../../lib/replay/viewer';

	document.querySelectorAll<HTMLElement>('.replay').forEach((el) => mountReplay(el));
</script>
