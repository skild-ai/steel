{
  "name": "steel-site",
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/write-notices.mjs dist && node scripts/check-links.mjs dist && node scripts/check-examples.mjs dist",
    "preview": "astro preview",
    "check-links": "node scripts/check-links.mjs dist",
    "check-figures": "node scripts/check-figures.mjs dist",
    "build:pages": "export STEEL_SITE_BASE=/steel/ && astro build --outDir dist-pages && node scripts/write-notices.mjs dist-pages && node scripts/check-links.mjs dist-pages && node scripts/check-examples.mjs dist-pages",
    "check-figures:pages": "STEEL_SITE_BASE=/steel/ node scripts/check-figures.mjs dist-pages",
    "check-replay": "node scripts/check-replay.mjs dist",
    "check-replay:pages": "STEEL_SITE_BASE=/steel/ node scripts/check-replay.mjs dist-pages",
    "astro": "astro",
    "check-examples": "node scripts/check-examples.mjs dist"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.8",
    "@astrojs/starlight": "0.42.11",
    "astro": "7.4.11",
    "katex": "0.19.1",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "sharp": "0.35.3",
    "smol-toml": "1.9.1",
    "starlight-links-validator": "0.27.0",
    "three": "0.187.0",
    "unist-util-visit": "5.2.0"
  },
  "private": true,
  "license": "Apache-2.0",
  "description": "Docs and tutorials site for Steel",
  "engines": {
    "node": ">=22.23.4"
  },
  "devDependencies": {
    "playwright-core": "1.65.0"
  }
}
